+"""Regression checks for the PDF completion screen's Back stack."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+SRC = ROOT / 'src/com/umedjon/filemanager'
+
+
+class Release196(unittest.TestCase):
+    def test_version_increments_from_public_195(self):
+        config = (ROOT / 'apk/apktool.yml').read_text()
+        self.assertIn("versionCode: '2103107'", config)
+        self.assertIn('versionName: 19.6', config)
+
+    def test_dialog_dismisses_only_after_successful_launch(self):
+        source = (SRC / 'PhotoPdfProgressDialog.java').read_text()
+        start = source.index('dialog.getButton(-1).setOnClickListener')
+        end = source.index('refresher[0].run()', start)
+        handler = source[start:end]
+        self.assertIn('PhotoPdfStore.DONE.equals(job.state)', handler)
+        self.assertIn('!job.result.isEmpty()', handler)
+        launch = handler.index('PhotoPdfResultActivity.open(owner,Uri.parse(job.result),job.folder)')
+        dismiss = handler.index('dialog.dismiss()')
+        self.assertLess(launch, dismiss)
+        self.assertEqual(handler.count('dialog.dismiss()'), 1)
+
+    def test_dismiss_stops_polling_and_finishes_original_host(self):
+        source = (SRC / 'PhotoPdfProgressDialog.java').read_text()
+        host = (SRC / 'PhotoPdfActivity.java').read_text()
+        self.assertIn('handler.removeCallbacks(refresher[0])', source)
+        self.assertIn('if(onHide!=null)onHide.run()', source)
+        self.assertIn('PhotoPdfProgressDialog.show(this,queuedJob,this::finish)', host)
+
+    def test_notification_progress_screen_does_not_remain_on_stack(self):
+        source = (SRC / 'PhotoPdfProgressActivity.java').read_text()
+        action = source[source.index('private void openResult()'):]
+        self.assertIn('PhotoPdfResultActivity.open(this,Uri.parse(job.result),job.folder)', action)
+        self.assertIn('finish()', action)
+        self.assertLess(action.index('PhotoPdfResultActivity.open('), action.index('finish()'))
+
+    def test_hide_and_background_queue_are_unchanged(self):
+        source = (SRC / 'PhotoPdfProgressDialog.java').read_text()
+        self.assertIn('setNegativeButton("Скрыть",(d,w)->{})', source)
+        self.assertIn('PhotoPdfService.cancel(owner,id)', source)
+        service = (SRC / 'PhotoPdfService.java').read_text()
+        self.assertIn('class PhotoPdfService', service)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
