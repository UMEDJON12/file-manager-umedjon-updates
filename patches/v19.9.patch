--- a/scripts/emulator-test-199.sh	1970-01-01 06:00:00.000000000 +0600
+++ b/scripts/emulator-test-199.sh	2026-11-15 23:54:24.843406797 +0500
@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+tool_dir="$RUNNER_TEMP/umedjon-emulator-199"
+mkdir -p "$tool_dir/classes" "$tool_dir/dex" "$tool_dir/logs"
+trap 'adb logcat -d -b main -b system -b crash > "$tool_dir/logs/logcat-on-exit.txt" 2>&1 || true' EXIT
+test_apk="$tool_dir/Release-Regression-Test.apk"
+signed_apk="$project_dir/output/File-Manager-UMEDJON-19.9.apk"
+android_jar="$ANDROID_HOME/platforms/android-35/android.jar"
+build_tools="$ANDROID_HOME/build-tools/35.0.0"
+
+test -e /dev/kvm
+test -r /dev/kvm
+test -w /dev/kvm
+test -f "$android_jar"
+test -s "$signed_apk"
+sha256sum "$signed_apk" | tee "$tool_dir/logs/tested-apk-sha256.txt"
+"$build_tools/apksigner" verify --verbose --print-certs "$signed_apk" | tee "$tool_dir/logs/signed-apk-verification.txt"
+grep -F '6259589d30dcf7fb984b1f973ed50c7e2a32372a0eb05c13efaa2cbac554a899' "$tool_dir/logs/signed-apk-verification.txt"
+
+javac -source 8 -target 8 -encoding UTF-8 -cp "$android_jar" -d "$tool_dir/classes" \
+  "$project_dir/tests/emulator197/FavoritesInstrumentation.java" \
+  "$project_dir/tests/emulator199/NavigationInstrumentation.java"
+jar cf "$tool_dir/instrumentation.jar" -C "$tool_dir/classes" .
+java -cp "$project_dir/toolchain/sdk/android-15/lib/d8.jar" com.android.tools.r8.D8 --min-api 21 --lib "$android_jar" --output "$tool_dir/dex" "$tool_dir/instrumentation.jar"
+"$build_tools/aapt2" link -I "$android_jar" --manifest "$project_dir/tests/emulator199/AndroidManifest.xml" -o "$tool_dir/test-unsigned.apk"
+python3 - "$tool_dir/test-unsigned.apk" "$tool_dir/dex/classes.dex" <<'PY'
+import sys,zipfile
+with zipfile.ZipFile(sys.argv[1],'a') as z:
+    z.write(sys.argv[2],'classes.dex',compress_type=zipfile.ZIP_DEFLATED)
+PY
+"$build_tools/zipalign" -f -p 4 "$tool_dir/test-unsigned.apk" "$tool_dir/test-aligned.apk"
+test -s "$RUNNER_TEMP/umedjon-original.jks"
+"$build_tools/apksigner" sign --ks "$RUNNER_TEMP/umedjon-original.jks" --ks-pass "pass:$UMEDJON_STORE_PASS" \
+  --key-pass "pass:$UMEDJON_KEY_PASS" --ks-key-alias "$UMEDJON_KEY_ALIAS" --out "$test_apk" "$tool_dir/test-aligned.apk"
+
+adb wait-for-device
+test "$(adb shell getprop sys.boot_completed | tr -d '\r')" = 1
+adb shell getprop ro.build.version.sdk | tee "$tool_dir/logs/emulator-sdk.txt"
+adb shell getprop ro.product.cpu.abi | tee "$tool_dir/logs/emulator-abi.txt"
+adb shell settings put system font_scale 1.5
+
+mkdir -p "$tool_dir/previous"
+gh release download v19.6 --repo UMEDJON12/file-manager-umedjon-updates \
+  --pattern File-Manager-UMEDJON-19.6.apk --dir "$tool_dir/previous"
+previous_apk="$tool_dir/previous/File-Manager-UMEDJON-19.6.apk"
+echo 'dd1087b38cd0e8a74cadfe1d771de32d9a21a9be683c1943bcfc8089e09a0960  '"$previous_apk" | sha256sum -c -
+adb install "$previous_apk"
+adb shell pm grant com.umedjon.filemanager android.permission.POST_NOTIFICATIONS
+adb shell monkey -p com.umedjon.filemanager 1 | tee "$tool_dir/logs/start-196.txt"
+adb install "$test_apk"
+
+run_favorites() {
+  local mode="$1" output="$tool_dir/logs/favorites-$1.txt"
+  adb shell am instrument -w -r -e mode "$mode" \
+    com.umedjon.filemanager.test/com.umedjon.filemanager.test.FavoritesInstrumentation | tee "$output"
+  grep -F 'EMULATOR_TEST_PASS' "$output"
+  grep -F 'INSTRUMENTATION_CODE: -1' "$output"
+}
+run_navigation() {
+  local mode="$1" output="$tool_dir/logs/widget-$1.txt"
+  adb shell am instrument -w -r -e mode "$mode" \
+    com.umedjon.filemanager.test/com.umedjon.filemanager.test.NavigationInstrumentation | tee "$output"
+  grep -F 'NAVIGATION_TEST_PASS' "$output"
+  grep -F 'INSTRUMENTATION_CODE: -1' "$output"
+}
+
+run_favorites seed
+adb shell am force-stop com.umedjon.filemanager
+adb install -r "$signed_apk" | tee "$tool_dir/logs/upgrade.txt"
+adb shell appops set com.umedjon.filemanager MANAGE_EXTERNAL_STORAGE allow
+adb shell dumpsys package com.umedjon.filemanager | grep -m 1 'versionCode=2103110'
+adb shell monkey -p com.umedjon.filemanager 1 | tee "$tool_dir/logs/start-199.txt"
+run_favorites verify
+run_favorites queue_end
+run_navigation navigation
+adb shell am force-stop com.umedjon.filemanager
+run_navigation cold
+adb shell uiautomator dump /sdcard/window.xml || true
+adb pull /sdcard/window.xml "$tool_dir/logs/window.xml" || true
+adb shell screencap -p /sdcard/umedjon-final.png || true
+adb pull /sdcard/umedjon-final.png "$tool_dir/logs/final.png" || true
+adb logcat -d -b main -b crash > "$tool_dir/logs/logcat.txt"
+if grep -En 'Process: com.umedjon.filemanager|ANR in com.umedjon.filemanager' "$tool_dir/logs/logcat.txt" > "$tool_dir/logs/crashes.txt"; then
+  echo 'Android runtime crash or ANR found; inspect crashes.txt' >&2
+  exit 1
+fi
+sha256sum -c "$tool_dir/logs/tested-apk-sha256.txt"
+echo 'ALL_EMULATOR_TESTS_PASSED'
+touch "$tool_dir/logs/emulator-ok"
