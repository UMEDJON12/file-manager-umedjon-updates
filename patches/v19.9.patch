+package com.umedjon.filemanager.test;
+
+import android.app.*;
+import android.content.*;
+import android.database.sqlite.SQLiteDatabase;
+import android.media.MediaMetadata;
+import android.media.session.MediaController;
+import android.media.session.PlaybackState;
+import android.net.Uri;
+import android.os.*;
+import android.service.notification.StatusBarNotification;
+import android.view.KeyEvent;
+import android.widget.ListView;
+import java.io.*;
+import java.lang.reflect.*;
+import java.nio.*;
+import java.util.concurrent.Callable;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Real music, widget/navigation, notification and Back integration test. */
+public final class NavigationInstrumentation extends Instrumentation {
+ private static final String APP="com.umedjon.filemanager";
+ private static final String FAVORITES="com.umedjon.filemanager.FavoritesActivity";
+ private static final String MAIN="com.alphainventor.filemanager.activity.MainActivity";
+ private static final String FULL="com.alphainventor.filemanager.musicplayer.FullScreenPlayerActivity";
+ private Context context;
+ private volatile Activity resumed;
+ private volatile int resumes;
+ private int checks;
+ private MediaController playback;
+ private String sourceUri;
+
+ @Override public void onCreate(Bundle args){
+  super.onCreate(args);
+  new Thread(()->{
+   Bundle answer=new Bundle();
+   try{
+    context=getTargetContext();
+    ui(()->{((Application)context.getApplicationContext()).registerActivityLifecycleCallbacks(new Application.ActivityLifecycleCallbacks(){
+     public void onActivityCreated(Activity a,Bundle b){}
+     public void onActivityStarted(Activity a){}
+     public void onActivityResumed(Activity a){resumed=a;resumes++;}
+     public void onActivityPaused(Activity a){}
+     public void onActivityStopped(Activity a){}
+     public void onActivitySaveInstanceState(Activity a,Bundle b){}
+     public void onActivityDestroyed(Activity a){}
+    });return null;});
+    String mode=args==null?"navigation":args.getString("mode","navigation");
+    if("cold".equals(mode))cold();
+    else navigation();
+    answer.putString("stream","NAVIGATION_TEST_PASS: "+checks+" assertions, "+mode);
+    finish(Activity.RESULT_OK,answer);
+   }catch(Throwable t){
+    android.util.Log.e("UMEDJON_NAV_TEST","NAVIGATION_TEST_FAILURE",t);
+    answer.putString("stream","NAVIGATION_TEST_FAILURE: "+t);
+    finish(Activity.RESULT_CANCELED,answer);
+   }
+  },"navigation-emulator").start();
+ }
+ private void ok(boolean condition,String description){checks++;if(!condition)throw new AssertionError(description);}
+ private <T> T ui(Callable<T> job){
+  AtomicReference<T> value=new AtomicReference<>();AtomicReference<Throwable> error=new AtomicReference<>();
+  runOnMainSync(()->{try{value.set(job.call());}catch(Throwable t){error.set(t);}});
+  if(error.get()!=null)throw new AssertionError(error.get());return value.get();
+ }
+ private void await(String label,Callable<Boolean> condition,long timeout){
+  long end=SystemClock.uptimeMillis()+timeout;
+  while(SystemClock.uptimeMillis()<end){if(Boolean.TRUE.equals(ui(condition)))return;SystemClock.sleep(180);}
+  throw new AssertionError("Timeout: "+label);
+ }
+ private File wav(String name)throws Exception{
+  File dir=new File(Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS),"umedjon-navigation-regression");
+  ok(dir.isDirectory()||dir.mkdirs(),"test music folder is accessible");
+  File file=new File(dir,name);
+  int length=8000*280*2;
+  ByteBuffer head=ByteBuffer.allocate(44).order(ByteOrder.LITTLE_ENDIAN);
+  head.put(new byte[]{'R','I','F','F'}).putInt(36+length);
+  head.put(new byte[]{'W','A','V','E','f','m','t',' '}).putInt(16);
+  head.putShort((short)1).putShort((short)1).putInt(8000).putInt(16000);
+  head.putShort((short)2).putShort((short)16).put(new byte[]{'d','a','t','a'}).putInt(length);
+  try(FileOutputStream out=new FileOutputStream(file)){
+   out.write(head.array());byte[] zeros=new byte[8192];
+   for(int remaining=length;remaining>0;remaining-=Math.min(remaining,zeros.length))
+    out.write(zeros,0,Math.min(remaining,zeros.length));
+  }
+  return file;
+ }
+ private MediaController live()throws Exception{
+  Field f=Class.forName("com.umedjon.filemanager.Playback").getDeclaredField("controller");
+  f.setAccessible(true);return (MediaController)f.get(null);
+ }
+ private Object service()throws Exception{
+  Field f=Class.forName("com.umedjon.filemanager.Playback").getDeclaredField("service");
+  f.setAccessible(true);return f.get(null);
+ }
+ private PendingIntent widget()throws Exception{
+  Method m=Class.forName("com.umedjon.filemanager.PlayerWidget").getDeclaredMethod("openSource",Context.class);
+  m.setAccessible(true);return (PendingIntent)m.invoke(null,context);
+ }
+ private void seedFavorites(String uri)throws Exception{
+  context.deleteDatabase("umedjon_favorites.db");
+  try(SQLiteDatabase db=context.openOrCreateDatabase("umedjon_favorites.db",Context.MODE_PRIVATE,null)){
+   db.execSQL("CREATE TABLE favorites(uri TEXT PRIMARY KEY,media_id TEXT,title TEXT,folder TEXT,added INTEGER NOT NULL,logical_id TEXT,record TEXT,status TEXT,sort_order INTEGER)");
+   db.execSQL("PRAGMA user_version=3");
+   for(int n=0;n<19;n++){
+    String dummy=Uri.fromFile(new File(context.getFilesDir(),"other-"+n+".wav")).toString();
+    db.execSQL("INSERT INTO favorites(uri,media_id,title,folder,added,sort_order) VALUES(?,?,?,?,?,?)",
+     new Object[]{dummy,"dummy-"+n,"Другая композиция "+n,context.getFilesDir().getAbsolutePath(),1000-n,1000L-n});
+   }
+   db.execSQL("INSERT INTO favorites(uri,media_id,title,folder,added,sort_order) VALUES(?,?,?,?,?,?)",
+   new Object[]{uri,"source-nav-track","Модар",Uri.fromFile(new File(Uri.parse(uri).getPath()).getParentFile()).toString(),900,900});
+  }
+ }
+ private Activity launchFavorites(){
+  Activity activity=startActivitySync(new Intent(Intent.ACTION_MAIN).setClassName(context,FAVORITES)
+   .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+  await("Favorites controller",()->activity.getMediaController()!=null,15000);
+  return activity;
+ }
+ private void queue(File file,String origin)throws Exception{
+  sourceUri=Uri.fromFile(file).toString();
+  Intent start=new Intent("com.umedjon.filemanager.player.queue")
+   .setClassName(context,"com.example.android.uamp.MusicService");
+  start.putExtra("uris",new String[]{sourceUri}).putExtra("ids",new String[]{"source-nav-track"})
+   .putExtra("index",0).putExtra("origin",origin)
+   .putExtra("folder",Uri.fromFile(file.getParentFile()).toString())
+   .putExtra("START_FOREGROUND",true);
+  context.startForegroundService(start);
+  await(origin+" live audio",()->{
+   playback=live();PlaybackState s=playback==null?null:playback.getPlaybackState();
+   return s!=null&&s.getState()==PlaybackState.STATE_PLAYING&&playback.getMetadata()!=null;
+  },18000);
+  playback.getTransportControls().seekTo(120000);
+  await(origin+" seek settles",()->{
+   PlaybackState s=playback.getPlaybackState();
+   return s!=null&&s.getState()==PlaybackState.STATE_PLAYING&&s.getPosition()>=119000;
+  },12000);
+ }
+ private void unchanged(String event,int state,long before,String original,Object service)throws Exception{
+  SystemClock.sleep(500);
+  PlaybackState now=playback.getPlaybackState();MediaMetadata metadata=playback.getMetadata();
+  ok(now!=null&&now.getState()==state,event+" preserves play/pause state");
+  ok(now.getPosition()>=before-1800,event+" does not restart at 00:00: "+before+" -> "+now.getPosition());
+  ok(now.getPosition()<=before+5000,event+" does not skip forward");
+  ok(metadata!=null&&original.equals(metadata.getString("__SOURCE__")),event+" preserves real source URI");
+  ok(service==service(),event+" preserves MusicService instance");
+ }
+ private String currentSource(){MediaMetadata d=playback.getMetadata();return d==null?null:d.getString("__SOURCE__");}
+ private void widgetToFavorites(String label,int state)throws Exception{
+  long before=playback.getPlaybackState().getPosition();String original=currentSource();Object owner=service();
+  Activity previous=resumed;
+  PendingIntent action=widget();ok(action!=null,label+" widget PendingIntent exists");
+  action.send();
+  await(label+" opens Favorites source",()->resumed!=null&&resumed!=previous&&FAVORITES.equals(resumed.getClass().getName()),15000);
+  Activity favorite=resumed;
+  // FavoritesActivity consumes and removes the one-shot focus extra in onResume;
+  // the observable contract is the current track's row brought into view.
+  ok(sourceUri.equals(context.getSharedPreferences("umedjon_playback",0).getString("uri",null)),
+   label+" retains the exact active file URI");
+  int id=context.getResources().getIdentifier("umedjon_favorites_list","id",APP);
+  ListView list=ui(()->(ListView)favorite.findViewById(id));
+  ok(list!=null,label+" Favorites list exists");
+  await(label+" focuses source row",()->{
+   int first=list.getFirstVisiblePosition(),last=list.getLastVisiblePosition();
+   return first<=19&&last>=19;
+  },10000);
+  ok(ui(()->list.getAdapter().getCount())==20,label+" source list contains expected tracks");
+  unchanged(label,state,before,original,owner);
+ }
+ private PendingIntent notification()throws Exception{
+  NotificationManager manager=(NotificationManager)context.getSystemService(Context.NOTIFICATION_SERVICE);
+  for(StatusBarNotification note:manager.getActiveNotifications())
+   if(note.getId()==412&&APP.equals(note.getPackageName())&&note.getNotification().contentIntent!=null)
+    return note.getNotification().contentIntent;
+  return null;
+ }
+ private void notificationAndBack(String label,int state)throws Exception{
+  await(label+" real media notification",()->notification()!=null,15000);
+  long before=playback.getPlaybackState().getPosition();String original=currentSource();Object owner=service();
+  Activity previous=resumed;
+  notification().send();
+  await(label+" opens fullscreen from notification",()->resumed!=null&&resumed!=previous&&FULL.equals(resumed.getClass().getName()),15000);
+  unchanged(label+" notification tap",state,before,original,owner);
+  Activity fullscreen=resumed;long beforeBack=playback.getPlaybackState().getPosition();
+  sendKeyDownUpSync(KeyEvent.KEYCODE_BACK);
+  await(label+" Back leaves fullscreen",()->fullscreen.isFinishing()||!FULL.equals(resumed.getClass().getName()),10000);
+  unchanged(label+" Back",state,beforeBack,original,owner);
+ }
+ private void folderWidget(int state)throws Exception{
+  long before=playback.getPlaybackState().getPosition();String original=currentSource();Object owner=service();
+  Activity previous=resumed;
+  widget().send();
+  await("folder widget opens original file manager screen",()->resumed!=null&&resumed!=previous&&MAIN.equals(resumed.getClass().getName()),15000);
+  Intent route=new Intent("com.umedjon.filemanager.OPEN_PLAYBACK_SOURCE")
+   .setClassName(context,MAIN).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK|Intent.FLAG_ACTIVITY_CLEAR_TOP|Intent.FLAG_ACTIVITY_SINGLE_TOP);
+  PendingIntent expected=PendingIntent.getActivity(context,154,route,PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE);
+  ok(expected.equals(widget()),"folder widget sends established playback-source navigation intent");
+  unchanged("folder widget",state,before,original,owner);
+ }
+ private void navigation()throws Exception{
+  File favorite=wav("source-nav-favorites.wav");sourceUri=Uri.fromFile(favorite).toString();
+  seedFavorites(sourceUri);
+  Activity first=launchFavorites();ok(first!=null,"Favorites opened");
+  queue(favorite,"favorites");
+  widgetToFavorites("favorites playing",PlaybackState.STATE_PLAYING);
+  widgetToFavorites("favorites repeated",PlaybackState.STATE_PLAYING);
+  notificationAndBack("favorites playing",PlaybackState.STATE_PLAYING);
+  playback.getTransportControls().pause();
+  await("favorites paused",()->playback.getPlaybackState().getState()==PlaybackState.STATE_PAUSED,5000);
+  widgetToFavorites("favorites paused",PlaybackState.STATE_PAUSED);
+  notificationAndBack("favorites paused",PlaybackState.STATE_PAUSED);
+
+  queue(wav("source-nav-folder.wav"),"folder");
+  folderWidget(PlaybackState.STATE_PLAYING);
+  notificationAndBack("folder playing",PlaybackState.STATE_PLAYING);
+  playback.getTransportControls().pause();
+  await("folder paused",()->playback.getPlaybackState().getState()==PlaybackState.STATE_PAUSED,5000);
+  folderWidget(PlaybackState.STATE_PAUSED);
+  notificationAndBack("folder paused",PlaybackState.STATE_PAUSED);
+  long position=playback.getPlaybackState().getPosition();
+  ok(position>=119000,"position retained before cold-restart test");
+  context.getSharedPreferences("umedjon_navigation_probe",0).edit().putLong("paused",position).commit();
+  ui(()->{if(resumed!=null)resumed.finish();return null;});
+ }
+ private void cold()throws Exception{
+  long saved=context.getSharedPreferences("umedjon_navigation_probe",0).getLong("paused",0);
+  ok(saved>=119000,"pre-restart paused position stored");
+  PendingIntent action=widget();ok(action!=null,"cold widget PendingIntent exists");
+  action.send();
+  await("cold widget returns to MainActivity",()->resumed!=null&&MAIN.equals(resumed.getClass().getName()),15000);
+  SystemClock.sleep(1800);
+  long current=context.getSharedPreferences("umedjon_playback",0).getLong("position",0);
+  ok(current>=saved-1500,"cold widget retains bookmark, saved="+saved+" now="+current);
+  MediaController control=live();PlaybackState state=control==null?null:control.getPlaybackState();
+  ok(state==null||state.getState()!=PlaybackState.STATE_PLAYING,"cold opening does not autoplay");
+  ui(()->{resumed.finish();return null;});
+ }
+}
