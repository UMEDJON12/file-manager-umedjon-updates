+"""Regression gates for preserving playback state across external navigation."""
+from pathlib import Path
+import unittest
+
+ROOT=Path(__file__).resolve().parents[2]
+
+def read(path):return (ROOT/path).read_text()
+
+class ExternalNavigation199(unittest.TestCase):
+ def test_existing_widget_source_route_restored(self):
+  widget=read('src/com/umedjon/filemanager/PlayerWidget.java')
+  navigation=read('src/com/umedjon/filemanager/Navigation.java')
+  self.assertIn('new Intent(Navigation.ACTION)',widget)
+  self.assertIn('setClassName(c,"com.alphainventor.filemanager.activity.MainActivity")',widget)
+  self.assertIn('PendingIntent destination=openSource(c)',widget)
+  self.assertIn('"favorites".equals(p.getString("origin_kind",null))',navigation)
+  self.assertIn('putExtra("umedjon.focus_uri",uri)',navigation)
+  self.assertIn('Bridge.call(a,"p2",folder',navigation)
+  self.assertIn('focusRow(l,i)',navigation)
+
+ def test_live_media_session_cannot_be_prepared_again(self):
+  guard=read('src/com/umedjon/filemanager/Playback.java')
+  saved=read('src/com/umedjon/filemanager/SavedPlayer.java')
+  self.assertIn('static boolean sessionActive()',guard)
+  for state in ('STATE_PLAYING','STATE_PAUSED','STATE_BUFFERING'):
+   self.assertIn('case PlaybackState.'+state,guard)
+  self.assertIn('if(Playback.sessionActive())',saved)
+  self.assertIn('Playback.sessionActive()||(!force',saved)
+  self.assertIn('PLAY_PREPARE',saved)
+
+ def test_real_navigation_notification_and_back_tests(self):
+  test=read('tests/emulator199/NavigationInstrumentation.java')
+  for case in ('widgetToFavorites("favorites playing"','widgetToFavorites("favorites paused"',
+     'notificationAndBack("favorites playing"','notificationAndBack("favorites paused"',
+     'folderWidget(PlaybackState.STATE_PLAYING)','folderWidget(PlaybackState.STATE_PAUSED)',
+     'notificationAndBack("folder playing"','notificationAndBack("folder paused"',
+     'sendKeyDownUpSync(KeyEvent.KEYCODE_BACK)','seekTo(120000)',
+     'getActiveNotifications()','NAVIGATION_TEST_PASS','sourceUri.equals(context.getSharedPreferences(',
+     'preserves MusicService instance','does not restart at 00:00'):
+   self.assertIn(case,test)
+
+ def test_signed_apk_gate_and_emulator(self):
+  workflow=read('.github/workflows/build-release.yml')
+  script=read('scripts/emulator-test-199.sh')
+  config=read('apk/apktool.yml')
+  self.assertIn("versionCode: '2103110'",config)
+  self.assertIn('versionName: 19.9',config)
+  self.assertIn('reactivecircus/android-emulator-runner@v2',workflow)
+  self.assertIn('arch: x86_64',workflow)
+  self.assertIn('test -w /dev/kvm',script)
+  self.assertIn('apksigner" verify --verbose --print-certs',script)
+  self.assertIn('adb install -r "$signed_apk"',script)
+  self.assertIn('run_navigation navigation',script)
+  self.assertIn('run_navigation cold',script)
+  self.assertIn('sha256sum -c "$tool_dir/logs/tested-apk-sha256.txt"',script)
+  self.assertIn('test -f "$RUNNER_TEMP/umedjon-emulator-199/logs/emulator-ok"',workflow)
+
+if __name__=='__main__':unittest.main()
