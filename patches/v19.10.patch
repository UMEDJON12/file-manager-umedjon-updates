+"""Host regression gates for 19.10. NOT a substitute for device/TalkBack testing."""
+from pathlib import Path
+import re
+import sqlite3
+import unittest
+
+ROOT=Path(__file__).resolve().parents[2]
+def source(name):return (ROOT/'src/com/umedjon/filemanager'/name).read_text()
+F=source('FavoritesActivity.java')
+OPS=source('FavoritesFileActions.java')
+DB=source('FavoriteStore.java')
+HOOKS=source('Hooks.java')
+
+class FavoritesFiles1910(unittest.TestCase):
+ def test_version_and_original_signature_guard(self):
+  conf=(ROOT/'apk/apktool.yml').read_text()
+  self.assertIn("versionCode: '2103111'",conf)
+  self.assertIn('versionName: 19.10',conf)
+  self.assertIn('6259589d30dcf7fb984b1f973ed50c7e2a32372a0eb05c13efaa2cbac554a899',(ROOT/'scripts/build.py').read_text())
+ def test_selection_never_calls_play_on_long_press(self):
+  self.assertIn('list.setOnItemLongClickListener',F)
+  self.assertIn('container.setOnLongClickListener',F)
+  self.assertIn('ACTION_LONG_CLICK){toggle(track[0]);return true;}',F)
+  self.assertIn('if(selectionMode!=null){toggle(uri);return;}',F)
+  body=F.split('void toggle(String uri){')[1].split('final ActionMode.Callback')[0]
+  self.assertNotIn('play(',body)
+ def test_multiselect_and_menu(self):
+  for s in ('final LinkedHashSet<String> selected','startActionMode(selectionActions)',
+            '"Выделить всё"','"Снять выделение"','"Выбрано: "+selected.size()',
+            '"Копировать"','"Переместить"','"Переименовать"',
+            '"Удалить файл"','"Удалить из избранного"','"Поделиться"','"Свойства"'):
+   self.assertIn(s,F)
+  self.assertIn('selected.retainAll(idsOf(tracks))',F)
+ def test_distinct_deletions(self):
+  remove=OPS.split('static void removeFavorites(')[1].split('static void deleteFiles(')[0]
+  delete=OPS.split('static void deleteFiles(')[1].split('static void properties(')[0]
+  self.assertIn('db.removeUri(source)',remove)
+  self.assertNotIn('PortableFiles.delete',remove)
+  self.assertIn('PortableFiles.delete(a,source)',delete)
+  self.assertIn('db.removeUri(raw)',delete)
+  self.assertIn('"Удалить аудиофайлы?"',delete)
+ def test_move_does_not_delete_unverified_copy(self):
+  move=OPS.split('static void destination(')[1].split('static void rename(')[0]
+  self.assertIn('PortableFiles.hash(a,PortableFiles.stat(a,sourceUri),cancel)',move)
+  self.assertIn('PortableFiles.hash(a,PortableFiles.stat(a,created.toString()),cancel)',move)
+  self.assertLess(move.index('if(!before.equals(after))'),move.index('PortableFiles.delete(a,entry)'))
+  self.assertIn('relocate(a,created.toString(),sourceUri,entry.parent)',move)
+  self.assertIn('DocumentsContract.deleteDocument(a.getContentResolver(),created)',move)
+ def test_renamed_file_keeps_logical_record(self):
+  self.assertIn('db.relocate(old,updated,updated,folder)',OPS)
+  method=DB.split('void relocate(')[1]
+  self.assertIn('UPDATE',method.upper())
+  self.assertIn('db.update("favorites",cv,"uri=?"',method)
+  self.assertNotIn('db.delete("favorites"',method)
+  db=sqlite3.connect(':memory:')
+  db.execute('CREATE TABLE favorites(uri TEXT PRIMARY KEY,media_id TEXT,title TEXT,folder TEXT,added INTEGER NOT NULL,logical_id TEXT,record TEXT,status TEXT,sort_order INTEGER)')
+  db.execute("INSERT INTO favorites VALUES('file:///old.mp3','old-id','Модар','file:///music',1,'logical-1','{}',NULL,6)")
+  db.execute("UPDATE favorites SET uri='file:///new.mp3',media_id='file:///new.mp3' WHERE uri='file:///old.mp3'")
+  self.assertEqual(db.execute('SELECT logical_id,sort_order,title FROM favorites').fetchone(),('logical-1',6,'Модар'))
+ def test_existing_storage_and_share_engines(self):
+  for name in ('PortableFiles.stat','PortableFiles.delete','PortableFiles.open','PortableFiles.hash','ShareCompat.uriFor'):
+   self.assertIn(name,OPS)
+  self.assertIn('Intent.ACTION_OPEN_DOCUMENT_TREE',OPS)
+ def test_selection_keeps_scroll_and_playback_ui(self):
+  for item in ('getFirstVisiblePosition()','setSelectionFromTop','notifyDataSetChanged()',
+               'this::onPlaybackChanged','recalculateMatches();refreshVisibleRows()'):
+   self.assertIn(item,F)
+  self.assertIn('return stableId(logical==null?tracks.get(p)[0]:logical)',F)
+  self.assertIn('hasStableIds(){return true;}',F)
+ def test_missing_and_denied_sources_not_unsafe(self):
+  for x in ('menu.findItem(4).setVisible(allWritable)',
+             'menu.findItem(6).setVisible(allWritable)',
+             'menu.add(0,9,9,"Удалить из избранного")', # available even for missing tracks
+             'checkUriPermission','File file=new File(uri.getPath())'):
+   self.assertIn(x,F+'\n'+OPS)
+ def test_native_folder_entry_uses_existing_main_activity(self):
+  self.assertIn('umedjon.favorite.folder',OPS)
+  self.assertIn('Bridge.call(a,"p2",folder,(Runnable)()->focusFile(a,uri,0))',source('Navigation.java'))
+ def test_accessibility_selection_action(self):
+  self.assertIn('performAccessibilityAction(View v,int action,Bundle args)',F)
+  self.assertIn('"Выделить трек"',F)
+  self.assertIn('info.setSelected(marked)',F)
+  self.assertIn('info.setChecked(marked)',F)
+  self.assertIn('"Выделено, "+label',F)
+ def test_file_rows_have_single_logical_accessibility_node(self):
+  self.assertIn('row.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_YES)',HOOKS)
+  self.assertIn('name.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO)',HOOKS)
+  self.assertIn('quietPassive(row,name)',HOOKS)
+  self.assertIn('String description=rowDescription(row,title)',HOOKS)
+  self.assertNotIn('n.setContentDescription(rowDescription(',HOOKS)
+  self.assertIn('Integer.valueOf(OPEN).equals(child.getTag())',HOOKS)
+ def test_identity_on_dense_lists(self):
+  # Pure-data load check for stable 64-bit identities used by the adapter.
+  def stable_id(s):
+   h=0xcbf29ce484222325
+   for ch in s:h=((h^ord(ch))*0x100000001b3)&((1<<64)-1)
+   return h
+  for n in (50,300,1000,1500):
+   paths=[f'file:///storage/emulated/0/Download/{i:06d}_длинное_название_файла_{"x"*120}.mp3' for i in range(n)]
+   ids=[stable_id(x) for x in paths]
+   self.assertEqual(len(ids),len(set(ids)))
+   self.assertEqual([paths[i] for i in range(n)],paths)
+   self.assertNotEqual(stable_id(paths[0]),stable_id(paths[-1]))
+
+if __name__=='__main__':unittest.main()
