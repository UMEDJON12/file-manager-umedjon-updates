+    target=getTargetContext();
+    String mode=arguments==null?"widget":arguments.getString("mode","widget");
+    if("restore".equals(mode))verifyColdOpening();
+    else verifyWidgetScenarios();
+    result.putString("stream","WIDGET_TEST_PASS: "+checks+" assertions, mode="+mode);
+    finish(Activity.RESULT_OK,result);
+   }catch(Throwable failure){
+    android.util.Log.e("UMEDJON_WIDGET_TEST","WIDGET_TEST_FAILURE",failure);
+    result.putString("stream","WIDGET_TEST_FAILURE: "+failure);
+    finish(Activity.RESULT_CANCELED,result);
+   }
+  },"umedjon-widget-regression").start();
+ }
+ private void check(boolean ok,String message){checks++;if(!ok)throw new AssertionError(message);}
+ private <T> T ui(Callable<T> callable){
+  AtomicReference<T> value=new AtomicReference<>();AtomicReference<Throwable> error=new AtomicReference<>();
+  runOnMainSync(()->{try{value.set(callable.call());}catch(Throwable t){error.set(t);}});
+  if(error.get()!=null)throw new AssertionError(error.get());return value.get();
+ }
+ private void waitFor(String what,Callable<Boolean> condition,long ms){
+  long end=SystemClock.uptimeMillis()+ms;
+  while(SystemClock.uptimeMillis()<end){if(Boolean.TRUE.equals(ui(condition)))return;SystemClock.sleep(150);}
+  throw new AssertionError("Timeout: "+what);
+ }
+ private MediaController controller(){return source==null?null:source.getMediaController();}
+ private File audio(String name)throws Exception{
+  File file=new File(target.getFilesDir(),name);
+  int count=8000*280*2;
+  ByteBuffer head=ByteBuffer.allocate(44).order(ByteOrder.LITTLE_ENDIAN);
+  head.put(new byte[]{'R','I','F','F'}).putInt(36+count);
+  head.put(new byte[]{'W','A','V','E','f','m','t',' '}).putInt(16);
+  head.putShort((short)1).putShort((short)1).putInt(8000).putInt(16000);
+  head.putShort((short)2).putShort((short)16);
+  head.put(new byte[]{'d','a','t','a'}).putInt(count);
+  try(FileOutputStream out=new FileOutputStream(file)){
+   out.write(head.array());byte[] block=new byte[8192];
+   for(int remain=count;remain>0;remain-=Math.min(block.length,remain))out.write(block,0,Math.min(block.length,remain));
+  }
+  return file;
+ }
+ private Activity launchSource(){
+  Activity a=startActivitySync(new Intent(Intent.ACTION_MAIN)
+   .setClassName(target,"com.umedjon.filemanager.FavoritesActivity")
+   .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+  source=a;waitFor("connected media controller",()->controller()!=null,15000);
+  return a;
+ }
+ private void queue(File file,String origin)throws Exception{
+  Intent i=new Intent("com.umedjon.filemanager.player.queue")
+   .setClassName(target,"com.example.android.uamp.MusicService");
+  i.putExtra("uris",new String[]{Uri.fromFile(file).toString()});
+  i.putExtra("ids",new String[]{origin+"-widget-track"});
+  i.putExtra("index",0).putExtra("origin",origin)
+   .putExtra("folder",target.getFilesDir().getAbsolutePath())
+   .putExtra("START_FOREGROUND",true);
+  target.startForegroundService(i);
+  waitFor("real "+origin+" playback",()->{
+   MediaController c=controller();PlaybackState p=c==null?null:c.getPlaybackState();
+   return p!=null&&p.getState()==PlaybackState.STATE_PLAYING;
+  },15000);
+  controller().getTransportControls().seekTo(120000);
+  waitFor("seek reaches middle of track",()->{
+   PlaybackState s=controller().getPlaybackState();return s!=null&&s.getPosition()>=119000;
+  },5000);
+ }
+ private PendingIntent widgetDestination()throws Exception{
+  Class<?> type=Class.forName("com.umedjon.filemanager.PlayerWidget");
+  Method method=type.getDeclaredMethod("openPlayer",Context.class);method.setAccessible(true);
+  return (PendingIntent)method.invoke(null,target);
+ }
+ private Object playerInstance()throws Exception{
+  Class<?> type=Class.forName("com.umedjon.filemanager.Playback");
+  Field f=type.getDeclaredField("service");f.setAccessible(true);return f.get(null);
+ }
+ private void verifyUnchanged(PendingIntent action,int state,String label)throws Exception{
+  MediaController c=controller();PlaybackState before=c.getPlaybackState();
+  MediaMetadata metadata=c.getMetadata();
+  check(before!=null&&before.getPosition()>=119000,"before widget "+label+" position is nonzero");
+  check(before.getState()==state,"before widget "+label+" play/pause state");
+  Object engine=playerInstance();String original=metadata.getString("__SOURCE__");
+  check(original!=null,"source URI before widget "+label);
+  long position=before.getPosition();long item=before.getActiveQueueItemId();
+  action.send();SystemClock.sleep(850);
+  PlaybackState after=c.getPlaybackState();MediaMetadata later=c.getMetadata();
+  check(after!=null&&after.getState()==state,"widget preserves "+label+" play/pause state");
+  check(after.getPosition()>=position-1200,"widget does not rewind "+label+" from "+position+" to "+after.getPosition());
+  check(after.getPosition()<=position+2500,"widget does not skip forward "+label);
+  check(item==after.getActiveQueueItemId(),"widget preserves queue item "+label);
+  check(original.equals(later.getString("__SOURCE__")),"widget preserves track source "+label);
+  check(engine==playerInstance(),"widget preserves playback service instance "+label);
+ }
+ private void verifyWidgetScenarios()throws Exception{
+  launchSource();PendingIntent action=widgetDestination();
+  check(action!=null,"widget cover has launch PendingIntent");
+  ActivityMonitor first=addMonitor(PLAYER,null,false);
+  queue(audio("widget-favorite.wav"),"favorites");
+  verifyUnchanged(action,PlaybackState.STATE_PLAYING,"favorites playing");
+  Activity opened=waitForMonitorWithTimeout(first,10000);
+  check(opened!=null&&PLAYER.equals(opened.getClass().getName()),"widget opens full screen player, not folder");
+  verifyUnchanged(action,PlaybackState.STATE_PLAYING,"repeat tap one");
+  verifyUnchanged(action,PlaybackState.STATE_PLAYING,"repeat tap two");
+  controller().getTransportControls().pause();
+  waitFor("paused",()->controller().getPlaybackState().getState()==PlaybackState.STATE_PAUSED,5000);
+  verifyUnchanged(action,PlaybackState.STATE_PAUSED,"favorites paused");
+  queue(audio("widget-folder.wav"),"folder");
+  verifyUnchanged(action,PlaybackState.STATE_PLAYING,"folder playing");
+  controller().getTransportControls().pause();
+  waitFor("folder paused",()->controller().getPlaybackState().getState()==PlaybackState.STATE_PAUSED,5000);
+  verifyUnchanged(action,PlaybackState.STATE_PAUSED,"folder paused");
+  // Save a paused position to verify that a cold app opening never autoplays.
+  target.getSharedPreferences("umedjon_widget_probe",0).edit()
+   .putLong("paused_position",controller().getPlaybackState().getPosition()).commit();
+  ui(()->{opened.finish();source.finish();return null;});
+ }
+ private void verifyColdOpening()throws Exception{
+  long saved=target.getSharedPreferences("umedjon_widget_probe",0).getLong("paused_position",0);
+  check(saved>=119000,"pause position persisted before cold start");
+  PendingIntent destination=widgetDestination();
+  ActivityMonitor monitor=addMonitor(PLAYER,null,false);
+  destination.send();
+  Activity opened=waitForMonitorWithTimeout(monitor,15000);
+  check(opened!=null,"cold widget tap opens full player");
+  SystemClock.sleep(2000);
+  Class<?> playback=Class.forName("com.umedjon.filemanager.Playback");
+  Method prefs=playback.getDeclaredMethod("prefs",Context.class);prefs.setAccessible(true);
+  android.content.SharedPreferences store=(android.content.SharedPreferences)prefs.invoke(null,target);
+  check(store.getLong("position",0)>=saved-1500,"cold opening keeps saved position");
+  Object service=playerInstance();
+  if(service!=null){
+   Field control=playback.getDeclaredField("controller");control.setAccessible(true);
+   MediaController controller=(MediaController)control.get(null);
+   PlaybackState state=controller==null?null:controller.getPlaybackState();
+   check(state==null||state.getState()!=PlaybackState.STATE_PLAYING,"cold widget must not autoplay");
+  }
+  ui(()->{opened.finish();return null;});
+ }
+}
