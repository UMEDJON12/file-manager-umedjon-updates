+"""Widget regression gates for UMEDJON 19.8; emulator runs in GitHub Actions."""
+from pathlib import Path
+import unittest
+
+ROOT=Path(__file__).resolve().parents[2]
+WIDGET=(ROOT/'src/com/umedjon/filemanager/PlayerWidget.java').read_text()
+TEST=(ROOT/'tests/emulator198/WidgetInstrumentation.java').read_text()
+SCRIPT=(ROOT/'scripts/emulator-test-198.sh').read_text()
+WORKFLOW=(ROOT/'.github/workflows/build-release.yml').read_text()
+
+class Widget198(unittest.TestCase):
+ def test_version_and_signer_gate(self):
+  version=(ROOT/'apk/apktool.yml').read_text()
+  self.assertIn("versionCode: '2103109'",version)
+  self.assertIn('versionName: 19.8',version)
+  self.assertIn('6259589d30dcf7fb984b1f973ed50c7e2a32372a0eb05c13efaa2cbac554a899',SCRIPT)
+
+ def test_widget_art_opens_player_instead_of_navigating_to_folder(self):
+  self.assertIn('setClassName(c,"com.alphainventor.filemanager.musicplayer.FullScreenPlayerActivity")',WIDGET)
+  self.assertNotIn('new Intent(Navigation.ACTION)',WIDGET)
+  self.assertIn('PendingIntent destination=openPlayer(c)',WIDGET)
+  self.assertIn('v.setOnClickPendingIntent(cover,destination)',WIDGET)
+  self.assertIn('v.setOnClickPendingIntent(label,destination)',WIDGET)
+
+ def test_nav_intent_does_not_restart_track(self):
+  start=WIDGET.index('static PendingIntent openPlayer(')
+  end=WIDGET.index('public void onReceive(',start)
+  code=WIDGET[start:end]
+  self.assertNotIn('player.queue',code)
+  self.assertNotIn('playFromUri',code)
+  self.assertNotIn('play()',code)
+  self.assertIn('FLAG_ACTIVITY_SINGLE_TOP',code)
+
+ def test_real_audio_and_regression_coverage(self):
+  for phrase in ('seekTo(120000)','favorites playing','folder playing',
+                 'favorites paused','folder paused','repeat tap one','repeat tap two',
+                 'widget preserves playback service instance',
+                 'widget does not rewind','cold widget must not autoplay'):
+   self.assertIn(phrase,TEST)
+
+ def test_real_emulator_is_required_to_create_draft(self):
+  self.assertIn('test -w /dev/kvm',SCRIPT)
+  self.assertIn('adb install -r "$signed_apk"',SCRIPT)
+  self.assertIn('run_widget widget',SCRIPT)
+  self.assertIn('run_widget restore',SCRIPT)
+  self.assertIn('WIDGET_TEST_PASS',SCRIPT)
+  self.assertIn('sha256sum -c "$tool_dir/logs/tested-apk-sha256.txt"',SCRIPT)
+  self.assertIn('test -f "$RUNNER_TEMP/umedjon-emulator-198/logs/emulator-ok"',WORKFLOW)
+
+if __name__=='__main__':unittest.main()
