+package com.umedjon.filemanager.test;
+
+import android.app.Activity;
+import android.app.Instrumentation;
+import android.app.NotificationManager;
+import android.content.Context;
+import android.content.Intent;
+import android.database.sqlite.SQLiteDatabase;
+import android.media.MediaMetadata;
+import android.media.session.MediaController;
+import android.media.session.PlaybackState;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.SystemClock;
+import android.service.notification.StatusBarNotification;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.ListView;
+import android.widget.TextView;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Field;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.concurrent.Callable;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Executes inside the real release app, on a GitHub Actions Android emulator. */
+public final class FavoritesInstrumentation extends Instrumentation {
+ private static final String APP="com.umedjon.filemanager";
+ private static final String FAVORITES="com.umedjon.filemanager.FavoritesActivity";
+ private static final String TOKEN="preserved-user-data-19.6-to-19.7";
+ private int checks;
+ private Context target;
+ private Activity favorites;
+ private ListView list;
+ private int accent;
+ private String uriOne,uriTwo;
+
+ @Override public void onCreate(Bundle arguments){
+  super.onCreate(arguments);
+  Bundle args=arguments==null?new Bundle():arguments;
+  new Thread(()->{
+   Bundle result=new Bundle();
+   try{
+    target=getTargetContext();
+    if("seed".equals(args.getString("mode"))){
+     target.getSharedPreferences("umedjon_upgrade_probe",0).edit().putString("sentinel",TOKEN).commit();
+     check(TOKEN.equals(target.getSharedPreferences("umedjon_upgrade_probe",0).getString("sentinel","")),"seed upgrade marker");
+    }else if("queue_end".equals(args.getString("mode"))){
+     verifyCompletedQueueNotification();
+    }else{
+     runScenarios();
+    }
+    result.putString("stream","EMULATOR_TEST_PASS: "+checks+" assertions");
+    finish(Activity.RESULT_OK,result);
+   }catch(Throwable failure){
+    android.util.Log.e("UMEDJON_EMULATOR_TEST","EMULATOR_TEST_FAILURE",failure);
+    result.putString("stream","EMULATOR_TEST_FAILURE: "+failure.toString());
+    finish(Activity.RESULT_CANCELED,result);
+   }
+  },"umedjon-emulator-regression").start();
+ }
+ private void check(boolean condition,String message){
+  checks++;
+  if(!condition)throw new AssertionError(message);
+ }
+ private int id(String name){return target.getResources().getIdentifier(name,"id",APP);}
+ private <T> T ui(Callable<T> task){
+  AtomicReference<T> value=new AtomicReference<>();
+  AtomicReference<Throwable> error=new AtomicReference<>();
+  runOnMainSync(()->{try{value.set(task.call());}catch(Throwable t){error.set(t);}});
+  if(error.get()!=null)throw new AssertionError(error.get());
+  return value.get();
+ }
+ private void waitFor(String description,Callable<Boolean> condition,long timeoutMs){
+  long deadline=SystemClock.uptimeMillis()+timeoutMs;
+  while(SystemClock.uptimeMillis()<deadline){
+   if(Boolean.TRUE.equals(ui(condition)))return;
+   SystemClock.sleep(200);
+  }
+  throw new AssertionError("Timed out: "+description);
+ }
+ private File wav(String name)throws IOException{return wav(name,25);}
+ private File wav(String name,int seconds)throws IOException{
+  File file=new File(target.getFilesDir(),name);
+  int frames=8000*seconds,dataLength=frames*2;
+  ByteBuffer header=ByteBuffer.allocate(44).order(ByteOrder.LITTLE_ENDIAN);
+  header.put(new byte[]{'R','I','F','F'}).putInt(36+dataLength);
+  header.put(new byte[]{'W','A','V','E','f','m','t',' '}).putInt(16);
+  header.putShort((short)1).putShort((short)1).putInt(8000).putInt(16000);
+  header.putShort((short)2).putShort((short)16);
+  header.put(new byte[]{'d','a','t','a'}).putInt(dataLength);
+  try(FileOutputStream out=new FileOutputStream(file)){
+   out.write(header.array());
+   byte[] sample=new byte[4096];
+   for(int bytes=dataLength;bytes>0;bytes-=Math.min(sample.length,bytes))out.write(sample,0,Math.min(sample.length,bytes));
+   out.getFD().sync();
+  }
+  return file;
+ }
+ private void insert(SQLiteDatabase db,String uri,String mediaId,String title,int added){
+  db.execSQL("INSERT INTO favorites(uri,media_id,title,folder,added,sort_order) VALUES(?,?,?,?,?,?)",
+   new Object[]{uri,mediaId,title,"file:///data/user/0/"+APP+"/files",added,added*1000L});
+ }
+ private void seedFavorites()throws IOException{
+  File one=wav("fav-one.wav"),two=wav("fav-two.wav");
+  uriOne=Uri.fromFile(one).toString();uriTwo=Uri.fromFile(two).toString();
+  target.deleteDatabase("umedjon_favorites.db");
+  try(SQLiteDatabase db=target.openOrCreateDatabase("umedjon_favorites.db",Context.MODE_PRIVATE,null)){
+   db.execSQL("CREATE TABLE favorites(uri TEXT PRIMARY KEY,media_id TEXT,title TEXT,folder TEXT,added INTEGER NOT NULL,logical_id TEXT,record TEXT,status TEXT,sort_order INTEGER)");
+   db.execSQL("PRAGMA user_version=3");
+   for(int i=0;i<26;i++)insert(db,Uri.fromFile(new File(target.getFilesDir(),"unused-"+i+".wav")).toString(),"other-"+i,"Другая композиция "+i,100+i);
+   // Equal display titles must not be used to decide which row is active.
+   insert(db,uriOne,"unique-media-one","Модар",1000);
+   insert(db,uriTwo,"unique-media-two","Модар",999);
+  }
+ }
+ private View row(int position){
+  int first=list.getFirstVisiblePosition();
+  if(position<first||position>=first+list.getChildCount())return null;
+  return list.getChildAt(position-first);
+ }
+ private TextView title(int position){View row=row(position);return row==null?null:(TextView)row.findViewById(id("filename"));}
+ private ImageView marker(int position){View row=row(position);return row==null?null:(ImageView)row.findViewById(id("subicon"));}
+ private CharSequence description(int position){
+  View row=row(position);return row==null?null:row.findViewById(id("item_container")).getContentDescription();
+ }
+ private void show(String uri,String mediaId,int state){
+  ui(()->{
+   Method method=favorites.getClass().getDeclaredMethod("showPlayback",String.class,String.class,int.class);
+   method.setAccessible(true);
+   method.invoke(favorites,uri,mediaId,state);
+   return null;
+  });
+ }
+ private void syntheticPlaybackMode(boolean synthetic){
+  ui(()->{
+   Field field=favorites.getClass().getDeclaredField("mini");
+   field.setAccessible(true);
+   Object mini=field.get(favorites);
+   Method method=mini.getClass().getDeclaredMethod(synthetic?"stop":"start");
+   method.setAccessible(true);
+   method.invoke(mini);
+   return null;
+  });
+ }
+ private void verifyRow(int position,boolean highlighted,String spoken){
+  check(ui(()->title(position)!=null),"visible row "+position);
+  int visibleColor=ui(()->title(position).getCurrentTextColor());
+  check(highlighted?visibleColor==accent:visibleColor!=accent,
+   "row tint "+position+" actual="+Integer.toHexString(visibleColor)+" expected accent="+Integer.toHexString(accent));
+  check(ui(()->(marker(position).getVisibility()==View.VISIBLE)==highlighted),"play/pause icon "+position);
+  String actualDescription=ui(()->{
+   CharSequence d=description(position);
+   return d==null?"(null)":d.toString();
+  });
+  check(spoken==null?!actualDescription.contains("воспроизводится")&&!actualDescription.contains("пауза"):
+    actualDescription.contains(spoken),"screen reader description "+position+" actual='"+actualDescription+"' expected='"+spoken+"'");
+ }
+ private MediaController controller(){
+  return favorites.getMediaController();
+ }
+ private boolean playerNotificationVisible(){
+  NotificationManager manager=(NotificationManager)target.getSystemService(Context.NOTIFICATION_SERVICE);
+  for(StatusBarNotification n:manager.getActiveNotifications())if(n.getId()==412&&APP.equals(n.getPackageName()))return true;
+  return false;
+ }
+ private void verifyCompletedQueueNotification()throws Exception{
+  String[] sources=new String[10],ids=new String[10];
+  for(int i=0;i<10;i++){
+   File track=wav("queue-end-"+i+".wav",1);
+   sources[i]=Uri.fromFile(track).toString();ids[i]="queue-"+i;
+  }
+  Intent launch=new Intent(Intent.ACTION_MAIN).setClassName(target,FAVORITES).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+  favorites=startActivitySync(launch);
+  waitFor("media controller bound",()->controller()!=null,15000);
+  Intent queue=new Intent("com.umedjon.filemanager.player.queue").setClassName(target,"com.example.android.uamp.MusicService");
+  queue.putExtra("uris",sources).putExtra("ids",ids);
+  queue.putExtra("index",0).putExtra("origin","folder").putExtra("folder",target.getFilesDir().getAbsolutePath());
+  queue.putExtra("START_FOREGROUND",true);
+  target.startForegroundService(queue);
+  waitFor("first short track begins",()->controller()!=null&&controller().getPlaybackState()!=null&&controller().getPlaybackState().getState()==PlaybackState.STATE_PLAYING,15000);
+  waitFor("tenth track starts after first nine",()->{
+   MediaController c=controller();
+   return c!=null&&c.getPlaybackState()!=null&&c.getPlaybackState().getState()==PlaybackState.STATE_PLAYING&&
+    c.getPlaybackState().getActiveQueueItemId()==9;
+  },25000);
+  // The legacy engine resets active item ID to zero on STOPPED; do not
+  // compare metadata after completion because it restores the first item.
+  waitFor("tenth track naturally finishes",()->controller()!=null&&controller().getPlaybackState()!=null&&
+   controller().getPlaybackState().getState()==PlaybackState.STATE_STOPPED,12000);
+  waitFor("notification stays after last track ends",()->playerNotificationVisible(),8000);
+  SystemClock.sleep(35000); // Detect old 30-second delayed service shutdown.
+  check(playerNotificationVisible(),"notification survives delayed stop deadline");
+  Intent close=new Intent("com.umedjon.filemanager.player.close").setClassName(target,"com.example.android.uamp.MusicService");
+  close.putExtra("START_FOREGROUND",true);
+  target.startForegroundService(close);
+  waitFor("explicit close removes panel",()->!playerNotificationVisible(),10000);
+  ui(()->{favorites.finish();return null;});
+ }
+ private void runScenarios()throws Exception{
+  check(TOKEN.equals(target.getSharedPreferences("umedjon_upgrade_probe",0).getString("sentinel","")),
+   "settings persisted after signed upgrade");
+  seedFavorites();
+  Intent intent=new Intent(Intent.ACTION_MAIN).setClassName(target,FAVORITES);
+  intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+  favorites=startActivitySync(intent);
+  check(favorites!=null,"favorites Activity started");
+  list=ui(()->(ListView)favorites.findViewById(id("umedjon_favorites_list")));
+  check(list!=null,"favorites ListView exists");
+  waitFor("populated favorites",()->list.getChildCount()>1,10000);
+  syntheticPlaybackMode(true); // Prevent unrelated real-session callbacks overriding simulated states.
+  check(ui(()->list.getAdapter().getCount())==28,"all favorites shown");
+  accent=target.getResources().getColor(target.getResources().getIdentifier("bt_accent","color",APP));
+  show(uriOne,"unique-media-one",PlaybackState.STATE_PLAYING);
+  verifyRow(0,true,"Модар, сейчас воспроизводится");
+  verifyRow(1,false,null);
+  show(uriTwo,"unique-media-two",PlaybackState.STATE_PLAYING);
+  verifyRow(0,false,null);
+  verifyRow(1,true,"Модар, сейчас воспроизводится");
+  show(uriTwo,"unique-media-two",PlaybackState.STATE_PAUSED);
+  verifyRow(1,true,"Модар, пауза");
+  show(uriTwo,"unique-media-two",PlaybackState.STATE_STOPPED);
+  verifyRow(0,false,null);
+  verifyRow(1,false,null);
+  // Distinct source URI, but unambiguous stable media ID for the same file.
+  show("content://external/alternative-copy","unique-media-one",PlaybackState.STATE_PLAYING);
+  verifyRow(0,true,"сейчас воспроизводится");
+  verifyRow(1,false,null);
+  show("content://external/alternative-copy","other-7",PlaybackState.STATE_PLAYING);
+  verifyRow(0,false,null);
+  verifyRow(1,false,null);
+  ui(()->{list.setSelectionFromTop(10,0);return null;});
+  waitFor("scrolled list",()->list.getFirstVisiblePosition()>=9,5000);
+  int first=ui(()->list.getFirstVisiblePosition());
+  show(uriOne,"unique-media-one",PlaybackState.STATE_PLAYING);
+  check(ui(()->list.getFirstVisiblePosition())==first,"scroll preserved after playback update");
+  show(null,null,PlaybackState.STATE_NONE);
+  // Use the real player and real files, not only simulated UI state.
+  syntheticPlaybackMode(false);
+  ui(()->{list.setSelectionFromTop(0,0);return null;});
+  waitFor("first audio row",()->row(0)!=null,5000);
+  waitFor("real MediaController connected",()->controller()!=null,15000);
+  ui(()->{list.performItemClick(row(0),0,0);return null;});
+  waitFor("real audio playback",()->{
+   MediaController c=controller();
+   if(c==null||c.getMetadata()==null||c.getPlaybackState()==null)return false;
+   String source=c.getMetadata().getString("__SOURCE__");
+   int state=c.getPlaybackState().getState();
+   return uriOne.equals(source)&&state==PlaybackState.STATE_PLAYING;
+  },20000);
+  waitFor("real playback indicator",()->title(0)!=null&&title(0).getCurrentTextColor()==accent,5000);
+  verifyRow(0,true,"сейчас воспроизводится");
+  ui(()->{list.performItemClick(row(1),1,1);return null;});
+  waitFor("second real audio playback",()->{
+   MediaController c=controller();
+   return c!=null&&c.getMetadata()!=null&&uriTwo.equals(c.getMetadata().getString("__SOURCE__"))&&c.getPlaybackState()!=null&&c.getPlaybackState().getState()==PlaybackState.STATE_PLAYING;
