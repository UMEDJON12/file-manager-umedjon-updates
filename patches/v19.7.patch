+"""Release 19.7 regression checks. Android behavioral tests run in GitHub Actions."""
+from pathlib import Path
+import unittest
+
+ROOT=Path(__file__).resolve().parents[2]
+SOURCE=(ROOT/"src/com/umedjon/filemanager/FavoritesActivity.java").read_text()
+MINI=(ROOT/"src/com/umedjon/filemanager/MiniPlayer.java").read_text()
+PLAYBACK=(ROOT/"src/com/umedjon/filemanager/Playback.java").read_text()
+
+
+class Favorites197(unittest.TestCase):
+    def test_version(self):
+        data=(ROOT/"apk/apktool.yml").read_text()
+        self.assertIn("versionCode: '2103108'",data)
+        self.assertIn("versionName: 19.7",data)
+
+    def test_real_identity_not_title(self):
+        self.assertIn('sameSource(currentSource,track[0])',SOURCE)
+        self.assertIn('currentMediaId.equals(track[1])',SOURCE)
+        self.assertIn('mediaIdMatches==1',SOURCE)
+        self.assertNotIn('currentSource.equals(track[2])',SOURCE)
+
+    def test_pause_and_stop_states(self):
+        self.assertIn('PlaybackState.STATE_PAUSED',SOURCE)
+        self.assertIn('PlaybackState.STATE_PLAYING',SOURCE)
+        self.assertIn('marker.setVisibility(active?View.VISIBLE:View.GONE)',SOURCE)
+        self.assertIn('playing?"ic_play_arrow":"ic_pause"',SOURCE)
+
+    def test_accessibility_descriptions(self):
+        self.assertIn('сейчас воспроизводится',SOURCE)
+        self.assertIn(', пауза',SOURCE)
+        self.assertIn('View.IMPORTANT_FOR_ACCESSIBILITY_NO',SOURCE)
+
+    def test_no_adapter_reset_on_player_callback(self):
+        start=SOURCE.index('void showPlayback(')
+        end=SOURCE.index('protected void onResume()',start)
+        self.assertIn('refreshVisibleRows()',SOURCE[start:end])
+        self.assertNotIn('setAdapter(',SOURCE[start:end])
+        self.assertNotIn('notifyDataSetChanged(',SOURCE[start:end])
+
+    def test_real_media_session_callback(self):
+        self.assertIn('this::onPlaybackChanged',SOURCE)
+        self.assertIn('getMetadata()',SOURCE)
+        self.assertIn('getPlaybackState()',SOURCE)
+        self.assertIn('onMetadataChanged(MediaMetadata m){render();}',MINI)
+        self.assertIn('onPlaybackStateChanged(PlaybackState p){render();}',MINI)
+        self.assertIn('if(active&&onPlaybackChanged!=null)onPlaybackChanged.run()',MINI)
+
+    def test_emulator_hard_gate_present(self):
+        script=(ROOT/"scripts/emulator-test-197.sh").read_text()
+        self.assertIn('test -w /dev/kvm',script)
+        self.assertIn('adb install -r "$signed_apk"',script)
+        self.assertIn("EMULATOR_TEST_PASS",script)
+        self.assertIn('sha256sum -c "$tool_dir/logs/tested-apk-sha256.txt"',script)
+        test=(ROOT/"tests/emulator197/FavoritesInstrumentation.java").read_text()
+        self.assertIn('real audio playback',test)
+        self.assertIn('real paused state',test)
+        self.assertIn('settings persisted after signed upgrade',test)
+
+    def test_queue_end_keeps_notification_until_explicit_close(self):
+        manager=(ROOT/'apk/smali/ax/X4/g.smali').read_text()
+        service=(ROOT/'apk/smali/com/example/android/uamp/MusicService.smali').read_text()
+        callback=(ROOT/'apk/smali/ax/V4/d$a.smali').read_text()
+        # The legacy queue wraps from the final item to the first; it stops
+        # through M(true), not the no-next-item branch alone.
+        self.assertGreaterEqual(manager.count('Playback;->queueFinished()V'),3)
+        self.assertIn('Playback;->queueEndPending()Z',service)
+        self.assertIn('Playback;->queueEndPending()Z',callback)
+        self.assertIn('invoke-virtual {p1}, Lax/V4/d;->l()V',callback)
+        self.assertIn('clearQueueEnd();SavedPlayer.closed()',PLAYBACK)
+        self.assertIn('ensureMediaChannel(s);service=s;',PLAYBACK)
+        self.assertIn('getNotificationChannel("music_player")==null',PLAYBACK)
+
+    def test_ten_track_end_emulator_scenario(self):
+        script=(ROOT/'scripts/emulator-test-197.sh').read_text()
+        instrument=(ROOT/'tests/emulator197/FavoritesInstrumentation.java').read_text()
+        self.assertIn('run_instrument queue_end',script)
+        self.assertIn('String[] sources=new String[10]',instrument)
+        self.assertIn('notification survives delayed stop deadline',instrument)
+        self.assertIn('explicit close removes panel',instrument)
+
+
+if __name__=="__main__":
+    unittest.main()
